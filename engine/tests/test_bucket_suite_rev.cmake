string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef label)
set(d "${ROOT}/bucket-tests-${label}")
file(MAKE_DIRECTORY "${d}")
execute_process(COMMAND "${DENSE}" OUTPUT_FILE "${d}/dense.txt" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "Independent dense check failed: ${rc}")
endif()
execute_process(COMMAND bash "${SCRIPTS}/bucket_checks_rev.sh" "${ORBIT}" "${d}/checks" "${d}/dense.txt" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "Checkpoint and containment gates failed: ${rc}")
endif()
execute_process(COMMAND bash "${SCRIPTS}/bucket_recovery_test_rev.sh" "${ORBIT}" "${d}/recovery" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "Forced-cap recovery failed: ${rc}")
endif()
