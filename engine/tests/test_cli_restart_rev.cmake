if(NOT DEFINED PROGRAM OR NOT DEFINED WORK_ROOT)
  message(FATAL_ERROR "PROGRAM and WORK_ROOT required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef tag)
set(work "${WORK_ROOT}/cli-restart-${tag}")
file(MAKE_DIRECTORY "${work}")
function(run_case expected label)
  execute_process(COMMAND "${PROGRAM}" ${ARGN} RESULT_VARIABLE result
    OUTPUT_FILE "${work}/${label}.stdout" ERROR_FILE "${work}/${label}.stderr")
  if(NOT "${result}" STREQUAL "${expected}")
    file(READ "${work}/${label}.stderr" error)
    message(FATAL_ERROR "${label}: expected ${expected}, got ${result}: ${error}")
  endif()
endfunction()
set(common --model ring --n 4 --dt .015625 --threshold 1e-5 --cap 100000)
if(HAVE_MPFR)
  list(APPEND common --validated --residual-depth 1)
endif()
run_case(0 continuous ${common} --time .0625 --checkpoint "${work}/full.bin"
  --output "${work}/full.csv")
run_case(0 partial ${common} --time .03125 --checkpoint "${work}/partial.bin"
  --output "${work}/partial.csv")
run_case(0 extension --restart "${work}/partial.bin" --time .0625 --cap 200000
  --output "${work}/extension.csv")
foreach(name full extension)
  file(STRINGS "${work}/${name}.csv" rows REGEX "^[0-9]")
  list(GET rows -1 final)
  string(REGEX REPLACE ",[0-9.]+,[0-9.]+$" "" ${name}_final "${final}")
endforeach()
if(NOT "${full_final}" STREQUAL "${extension_final}")
  message(FATAL_ERROR "Uninterrupted/restarted final numerical CSV fields differ")
endif()
file(READ "${work}/partial.bin.manifest.json" manifest)
string(JSON reason GET "${manifest}" stop_reason)
string(JSON prior GET "${manifest}" prior_total_steps)
string(JSON cap GET "${manifest}" max_terms)
if(NOT reason STREQUAL "complete" OR NOT prior EQUAL 2 OR NOT cap EQUAL 200000)
  message(FATAL_ERROR "Restart extension provenance missing")
endif()
file(SHA256 "${work}/partial.bin" preserved)
run_case(2 changed_dt --restart "${work}/partial.bin" --dt .03125)
run_case(2 changed_threshold --restart "${work}/partial.bin" --threshold 2e-5)
run_case(2 changed_cap --restart "${work}/partial.bin" --cap 100)
run_case(2 changed_hamiltonian --restart "${work}/partial.bin" --model xy)
run_case(2 changed_backend --restart "${work}/partial.bin" --backend pthread)
run_case(2 changed_threads --restart "${work}/partial.bin" --threads 2)
run_case(2 shorter --restart "${work}/partial.bin" --time .015625)
run_case(2 overwrite_checkpoint ${common} --time .0625 --checkpoint "${work}/partial.bin")
run_case(2 overwrite_output ${common} --time .0625 --output "${work}/full.csv")
file(SHA256 "${work}/partial.bin" after)
if(NOT preserved STREQUAL after)
  message(FATAL_ERROR "Rejected commands altered checkpoint")
endif()
run_case(75 pause ${common} --time .0625 --walltime 1e-300
  --checkpoint "${work}/paused.bin" --output "${work}/paused.csv")
run_case(0 resume_paused --restart "${work}/paused.bin" --output "${work}/resumed.csv")
run_case(1 capped ${common} --cap 4 --time .0625 --checkpoint "${work}/capped.bin"
  --output "${work}/capped.csv")
run_case(0 resume_cap --restart "${work}/capped.bin" --cap 100000
  --output "${work}/uncapped.csv")
foreach(name resumed uncapped)
  file(STRINGS "${work}/${name}.csv" rows REGEX "^[0-9]")
  list(GET rows -1 final)
  string(REGEX REPLACE ",[0-9.]+,[0-9.]+$" "" comparable "${final}")
  if(NOT full_final STREQUAL comparable)
    message(FATAL_ERROR "Resumed ${name} result differs from uninterrupted result")
  endif()
endforeach()
if(HAVE_MPFR)
  run_case(76 accuracy ${common} --time .0625 --max-fid-bound 1e-20
    --checkpoint "${work}/accuracy.bin" --output "${work}/accuracy.csv")
  file(READ "${work}/accuracy.bin.manifest.json" manifest)
  string(JSON reason GET "${manifest}" stop_reason)
  if(NOT reason STREQUAL "accuracy_limit")
    message(FATAL_ERROR "Accuracy stop incorrectly labeled")
  endif()
  run_case(0 resume_accuracy --restart "${work}/accuracy.bin" --max-fid-bound 1
    --output "${work}/accuracy_resumed.csv")
endif()
message(STATUS "CLI restart/configuration/overwrite/walltime/resource/accuracy checks passed; logs ${work}")
